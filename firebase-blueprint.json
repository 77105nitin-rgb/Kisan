{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profile details for registered farmer, ag-officer, or admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The Firebase authenticated UID" },
        "name": { "type": "string", "description": "Human name of the user" },
        "email": { "type": "string", "description": "Email address" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "language": { "type": "string", "enum": ["en", "hi", "pa"], "description": "Multilingual preference" },
        "role": { "type": "string", "enum": ["farmer", "officer", "admin"], "description": "System role" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "language", "role", "createdAt", "updatedAt"]
    },
    "DiseaseReport": {
      "title": "DiseaseReport",
      "description": "Crop disease detection analysis reports generated by Gemini AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "cropType": { "type": "string" },
        "imageUrl": { "type": "string" },
        "diseaseName": { "type": "string" },
        "confidence": { "type": "number" },
        "causes": { "type": "string" },
        "symptoms": { "type": "array" },
        "prevention": { "type": "string" },
        "treatment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "cropType", "imageUrl", "diseaseName", "confidence", "createdAt"]
    },
    "SoilReport": {
      "title": "SoilReport",
      "description": "NPK composition analysis, pH, and recommendation engine result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "crop": { "type": "string" },
        "nitrogen": { "type": "number" },
        "phosphorus": { "type": "number" },
        "potassium": { "type": "number" },
        "soilType": { "type": "string" },
        "ph": { "type": "number" },
        "analysis": { "type": "string" },
        "fertilizerRecommendation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "crop", "nitrogen", "phosphorus", "potassium", "soilType", "ph", "analysis", "createdAt"]
    },
    "ChatHistory": {
      "title": "ChatHistory",
      "description": "Farmer interactive advisor dialog inputs and responses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "ai"] },
        "language": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "message", "sender", "language", "createdAt"]
    },
    "PestAlert": {
      "title": "PestAlert",
      "description": "Community pest alert vectors reported by farmers and officers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "reporterName": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "cropType": { "type": "string" },
        "pestName": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "description": { "type": "string" },
        "severityScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "reporterName", "district", "state", "cropType", "pestName", "severity", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Broadcast alerts and local farmer triggers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["weather", "disease", "mandi", "alert", "scheme"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "body", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user registration profiles mapped by Auth UID"
    },
    "/diseaseReports/{reportId}": {
      "schema": "DiseaseReport",
      "description": "Uploaded crop diagnostics analyzed by Gemini"
    },
    "/soilReports/{reportId}": {
      "schema": "SoilReport",
      "description": "Saved soil health profiles and custom fertilizer guidelines"
    },
    "/chatHistory/{chatId}": {
      "schema": "ChatHistory",
      "description": "Dialog cycles for the multilingual AI assistant"
    },
    "/pestAlerts/{alertId}": {
      "schema": "PestAlert",
      "description": "Outbreaks compiled to construct local district-level warning networks"
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "Push alerts compiled for district levels and personal prompts"
    }
  }
}
